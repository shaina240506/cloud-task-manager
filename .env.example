# Copy to .env and edit. Never commit .env.
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me
# Kafka configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=task-events
# Browser origin of the frontend (no trailing slash). On EC2: http://<EC2_PUBLIC_IP>
CORS_ALLOWED_ORIGINS=http://localhost
# URL the BROWSER uses to reach the backend. On EC2: http://<EC2_PUBLIC_IP>:8080
VITE_API_BASE_URL=http://localhost:8080

